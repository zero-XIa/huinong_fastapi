# ==================== 核心忽略：虚拟环境（最占体积，一行覆盖所有）====================
.venv/
venv/
env/
ENV/
*.env
.env.local
.env.dev
.env.prod

# ==================== Python 通用忽略（覆盖所有缓存/编译文件）====================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# ==================== FastAPI 相关忽略（日志/临时文件）====================
logs/
*.log
access.log
error.log
*.tmp
*.cache

# ==================== 编辑器/系统文件（覆盖 VS Code 等工具缓存）====================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==================== 其他冗余文件 ====================
*.pid
*.pyc
*.pyo
*.pyd
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
uploads/
